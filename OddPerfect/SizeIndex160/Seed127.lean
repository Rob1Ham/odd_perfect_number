private theorem checked : replay bank 127 1 (10^160) 32 root witness = true := by
  decide +kernel

theorem exclude_127 {N : ℕ} (ho : Odd N) (hN : N.Perfect) (hs : 127 ∣ N)
    (hav : Nat.Coprime 1 N) (hx : N ≤ 10^160) : False :=
  replay_correct ho hN hs hav hx bank bank_valid 32 (root_valid N) witness checked

end OddPerfect.IndexComponent.Size160
